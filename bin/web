#!/usr/bin/env bash
# The client's five checks, in the order CI runs them.
#
# `desktop/webapp/` is a second toolchain inside a Python repository: TypeScript, Vite,
# Vitest. The four commands are written in `package.json` and CI spells them out one by
# one; this script is that list in one place, plus the one check that only exists in the
# workflow — the **bundle-drift** check. The built bundle is committed so `pip install`
# never needs Node, and a rebuild that differs from what is committed means the copy a
# reviewer would draw is stale. That is a fact about the working tree, which is why it
# cannot live in `package.json`.
#
# `--check` skips `npm ci`: it asserts against the `node_modules/` already there, which
# is what a CI job that cached them does and what a local re-run wants. Both modes
# build — the drift check is only meaningful against a fresh build.
#
# Usage: bin/web [--check]
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WEBAPP="$REPO/desktop/webapp"
BUNDLE="$REPO/src/heimdall_qa/desktop/webapp"
CHECK=""

for argument in "$@"; do
    case "$argument" in
        --check) CHECK=1 ;;
        *) echo "usage: bin/web [--check]" >&2; exit 2 ;;
    esac
done

step() { printf '\n== %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

command -v node >/dev/null || fail "no node on PATH; the client build needs it"
NODE_VERSION="$(node --version | sed -n 's/^v\([0-9]*\).*/\1/p')"
[ -n "$NODE_VERSION" ] && [ "$NODE_VERSION" -ge 20 ] \
    || fail "node $(node --version) is too old for Vite 7 (20.19+ or 22.12+)"

if [ -n "$CHECK" ]; then
    step "dependencies"
    [ -d "$WEBAPP/node_modules" ] || fail "--check needs desktop/webapp/node_modules; run bin/web first"
    echo "using the node_modules already present"
else
    step "dependencies"
    (cd "$WEBAPP" && npm ci)
fi

step "typecheck"
(cd "$WEBAPP" && npm run typecheck)

step "lint"
(cd "$WEBAPP" && npm run lint)

step "test"
(cd "$WEBAPP" && npm test)

step "build"
(cd "$WEBAPP" && npm run build)

step "the committed bundle matches the sources"
# `git add -N` first: without it a bundle that was never committed is untracked and
# `git diff` reports nothing at all — the drift this exists to catch, reported as
# success. This is the same pair of commands the `client` job in CI runs.
git -C "$REPO" add -N src/heimdall_qa/desktop/webapp
git -C "$REPO" diff --stat -- src/heimdall_qa/desktop/webapp
git -C "$REPO" diff --exit-code -- src/heimdall_qa/desktop/webapp \
    || fail "the committed bundle is stale; commit the rebuild under $BUNDLE"

printf '\nthe client is green and the committed bundle is current\n'
