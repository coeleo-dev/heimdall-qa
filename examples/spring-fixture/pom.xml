<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Java proof target: a Spring Boot application whose only job is to be read by
  `heimdall-qa-spring` and then talked to, so the reader's numbers are checked
  against a real API instead of against our reading of one.

  Spring Boot 4.0.5 with `spring-boot-starter-webmvc`, which is what the reference
  API uses. Matching it is not decoration: the reader understands the shape of that
  generation of Spring, and a fixture on an older one would measure something else.

  Tier 1 of `tests/test_spring_fixture.py` never runs Maven — it reads these sources
  as text. Tier 2 does, and only when `mvn` (or this wrapper) is present, because a
  JDK is not a dependency of the harness.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>dev.heimdallqa</groupId>
    <artifactId>spring-fixture</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-fixture</name>
    <description>A minimal Spring Boot target for the Heimdall QA parity gate</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
